  "presentation": [
    {
      "id": "ch01",
      "title": "素数有规律吗？",
      "narration": "欧拉发现，所有素数的乘积与所有正整数的级数相等。高斯和勒让德数素数表，猜测 x 以内约有 x/ln x 个素数。",
      "durationSec": 13,
      "domainAt": 1798,
      "transitionMs": 900,
      "camera": {
        "fitIds": ["欧拉", "欧拉乘积公式", "高斯", "勒让德", "素数定理猜想"]
      },
      "highlight": {
        "nodeIds": ["欧拉", "欧拉乘积公式", "高斯", "勒让德", "素数定理猜想"]
      }
    },
    {
      "id": "ch02",
      "title": "从级数到估计",
      "narration": "狄利克雷把欧拉乘积推广为 L 函数，证明等差数列中有无穷多素数。切比雪夫把素数个数夹在两个常数倍之间。",
      "durationSec": 12,
      "domainAt": 1850,
      "transitionMs": 900,
      "camera": {
        "fitIds": ["狄利克雷", "狄利克雷 L 函数", "切比雪夫", "切比雪夫估计"]
      },
      "highlight": {
        "nodeIds": ["欧拉乘积公式", "狄利克雷", "狄利克雷 L 函数", "切比雪夫", "切比雪夫估计"]
      }
    },
    {
      "id": "ch03",
      "title": "1859：一篇八页的论文",
      "narration": "黎曼把 ζ 函数延拓到复平面，写出用零点表示素数的显式公式，并写下：所有非平凡零点“很可能”都在实部为 1/2 的直线上。",
      "durationSec": 15,
      "domainAt": 1859,
      "transitionMs": 900,
      "camera": {
        "fitIds": ["黎曼", "ζ 函数的解析延拓", "素数的显式公式", "黎曼猜想", "切比雪夫估计"]
