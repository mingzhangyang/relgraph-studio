    {
      "id": "欧拉乘积公式",
      "kind": "理论与成果",
      "visibleFrom": 1737,
      "summary": "对所有素数 p 的乘积 ∏(1-p^-s)^-1 等于对所有正整数 n 的和 Σ n^-s。素数第一次与一个解析函数绑在一起。",
      "evidence": ["Euler, Variae observationes circa series infinitas (1737/1744)"],
      "position": {
        "y": 210
      }
    },
    {
      "id": "素数定理猜想",
      "kind": "问题与事件",
      "visibleFrom": 1798,
      "summary": "高斯少年时估计 x 以内的素数约有 x/ln x 个（后改用对数积分 li(x)）；勒让德 1798 年发表了类似的经验公式。",
      "evidence": [
        "Legendre, Essai sur la théorie des nombres (1798)",
        "Gauss, letter to Encke (1849)"
      ],
      "position": {
        "y": 420
      }
    },
    {
      "id": "狄利克雷 L 函数",
      "kind": "理论与成果",
      "visibleFrom": 1837,
      "summary": "狄利克雷用带特征的级数证明：首项与公差互素的等差数列中有无穷多个素数。",
      "evidence": ["Dirichlet, Beweis des Satzes … (1837)"],
      "position": {
        "y": 262
      }
    },
    {
      "id": "切比雪夫估计",
      "kind": "理论与成果",
      "visibleFrom": 1850,
      "summary": "切比雪夫证明 π(x) 与 x/ln x 之比被夹在两个常数之间，为素数定理迈出第一步。",
      "evidence": ["Chebyshev, Mémoire sur les nombres premiers (1850/1852)"],
      "position": {
        "y": 315
      }
    },
    {
      "id": "ζ 函数的解析延拓",
      "kind": "理论与成果",
      "visibleFrom": 1859,
      "summary": "黎曼把 ζ(s) 延拓到整个复平面（s=1 除外），并给出联系 s 与 1-s 的函数方程。",
      "evidence": ["Riemann, Über die Anzahl der Primzahlen unter einer gegebenen Grösse (1859)"],
      "position": {
        "y": 262
      }
    },
    {
      "id": "素数的显式公式",
      "kind": "理论与成果",
      "visibleFrom": 1859,
      "summary": "素数计数可以写成主项减去对 ζ 的全部非平凡零点求和。零点的位置控制着素数分布的误差。",
      "evidence": ["Riemann (1859)", "von Mangoldt (1895)"],
      "position": {
        "y": 543
      }
    },
    {
      "id": "黎曼猜想",
      "kind": "问题与事件",
      "visibleFrom": 1859,
      "summary": "ζ(s) 的所有非平凡零点的实部都等于 1/2，即都落在“临界线”上。",
      "evidence": [
        {
          "cite": "Riemann (1859)",
          "quote": "es ist sehr wahrscheinlich, dass alle Wurzeln reell sind.",
          "locator": "Monatsberichte der Berliner Akademie, 1859",
          "url": "https://www.claymath.org/wp-content/uploads/2023/04/Wilkins-translation.pdf"
        }
      ],
      "position": {
        "y": -330
      }
    },
    {
      "id": "零点计数公式",
      "kind": "理论与成果",
      "visibleFrom": 1905,
      "summary": "高度 T 以下的非平凡零点约有 (T/2π)·ln(T/2πe) 个。黎曼给出陈述，冯·曼戈尔特于 1905 年完成证明。",
      "evidence": ["von Mangoldt, Zur Verteilung der Nullstellen … (1905)"],
      "position": {
        "y": -21
      }
    },
    {
      "id": "素数定理",
      "kind": "理论与成果",
      "visibleFrom": 1896,
      "summary": "阿达马与德拉瓦莱普桑各自证明 π(x) ~ x/ln x。关键一步是 ζ(s) 在直线 Re(s)=1 上没有零点。",
      "evidence": ["Hadamard (1896)", "de la Vallée Poussin (1896)"],
      "position": {
        "y": 740
      }
    },
