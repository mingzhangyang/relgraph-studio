  "evidence": [
    {
      "id": "lin-name",
      "sourceId": "page-58",
      "at": 2,
      "text": "這林如海姓林名海，表字如海",
      "context": "叙述者介绍盐政林如海；如海是字，海是名。",
      "verification": "transcription-and-scan-checked",
      "checkedAt": "2026-11-08"
    },
    {
      "id": "lin-daughter",
      "sourceId": "page-58",
      "at": 2,
      "text": "只嫡妻賈氏生得一女，乳名黛玉",
      "context": "林如海家世段；父女、母女与嫡妻身份同段明确。",
      "verification": "transcription-and-scan-checked",
      "checkedAt": "2026-11-08"
    },
    {
      "id": "min-death",
      "sourceId": "page-58",
      "at": 2,
      "text": "不料女學生之母賈氏夫人一病而亡",
      "context": "第二回叙述贾氏去世；只作已揭示背景，不扩展后事。",
      "verification": "transcription-and-scan-checked",
      "checkedAt": "2026-11-08"
    },
    {
      "id": "shi-sons",
      "sourceId": "page-61",
      "at": 2,
      "text": "娶的是金陵世家史侯的小姐爲妻，生了兩個兒子，長名賈赦，次名賈政",
      "context": "冷子兴讲荣府：主语为贾代善之妻，后文称太夫人。",
      "verification": "transcription-and-scan-checked",
      "checkedAt": "2026-11-08"
    },
    {
      "id": "shi-living",
      "sourceId": "page-61",
      "at": 2,
      "text": "如今代善早已去世，太夫人尙在",
      "context": "承接史侯小姐及两个儿子的同一段人物指称。",
      "verification": "transcription-and-scan-checked",
      "checkedAt": "2026-11-08"
    },
    {
      "id": "baoyu-name",
      "sourceId": "page-63",
      "at": 2,
      "text": "所以方纔你一說這寳玉",
      "context": "雨村对冷子兴所述衔玉公子的回指；指人物，不是第一回的通灵宝玉物件。",
      "verification": "transcription-and-scan-checked",
      "checkedAt": "2026-11-08"
    },
    {
      "id": "shi-alias",
      "sourceId": "page-65",
      "at": 2,
      "text": "因史老夫人極愛孫女",
      "context": "第二回对同一荣府太夫人的史姓称谓。",
      "verification": "transcription-and-scan-checked",
      "checkedAt": "2026-11-08"
    },
    {
      "id": "min-identity",
      "sourceId": "page-65",
      "at": 2,
      "text": "目今你貴東家林公之夫人，卽榮府中赦政二公之胞妹，在家時名字喚賈敏",
      "context": "冷子兴明确把林公夫人、贾氏、贾敏及贾政胞妹连接起来。",
