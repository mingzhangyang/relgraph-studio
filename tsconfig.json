{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@relgraph/core": ["packages/core/src/index.ts"],
      "@relgraph/render": ["packages/render/src/index.ts"],
      "@relgraph/render/skia": ["packages/render/src/backends/skia.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "tests/types/**/*.ts"],
  "exclude": ["packages/*/dist", "node_modules"]
}
