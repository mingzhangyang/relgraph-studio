{
  "name": "relgraph-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:types": "node scripts/generate-types.mjs",
    "check:types": "node scripts/generate-types.mjs --check",
    "lint": "eslint \"packages/**/*.ts\" \"apps/**/*.ts\" \"tests/**/*.ts\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"*.config.mjs\"",
    "format:check": "prettier --check \"packages/**/*.ts\" \"packages/*/*.json\" \"apps/**/*.ts\" \"tests/**/*.ts\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"*.config.mjs\" \"datasets/**/*.json\" examples/manifest.json tsconfig.json package.json .prettierrc.json",
    "format:write": "prettier --write \"packages/**/*.ts\" \"packages/*/*.json\" \"apps/**/*.ts\" \"tests/**/*.ts\" \"tests/**/*.mjs\" \"scripts/**/*.mjs\" \"*.config.mjs\" \"datasets/**/*.json\" examples/manifest.json tsconfig.json package.json .prettierrc.json",
    "build:packages": "npm run build --workspace=@relgraph/core && npm run build --workspace=@relgraph/render && npm run build --workspace=@relgraph/cli",
    "relgraph": "node packages/cli/dist/bin.js",
    "check:browser": "node scripts/browser-check.mjs",
    "check:export": "node scripts/check-export.mjs",
    "subset:fonts": "node scripts/subset-fonts.mjs",
    "check:honglou-sources": "node scripts/check-honglou-sources.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.7.0",
    "globals": "17.14.0",
    "json-schema-to-typescript": "16.0.0",
    "playwright": "1.63.0",
    "prettier": "3.9.10",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "overrides": {
    "eslint": {
      ".": "$eslint",
      "minimatch": "11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  },
  "workspaces": [
    "packages/core",
    "packages/render",
    "packages/cli"
  ]
}
