{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "resolveJsonModule": true,
    "noEmitOnError": true,
    "declaration": true,
    "rootDir": ".",
    "outDir": "dist",
    "types": [],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "types/**/*.ts", "schema/**/*.json"],
  "exclude": ["dist"]
}
