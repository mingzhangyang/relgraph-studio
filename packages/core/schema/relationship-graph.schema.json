{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RelGraph v0.1 (draft)",
  "description": "Narrative relationship graph interchange format. Early draft; semantic checks are separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "meta",
    "characters",
    "relations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "timeline": {
      "$ref": "#/$defs/timeline"
    },
    "factions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/faction"
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/character"
      },
      "minItems": 1
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "presentation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "extra": {
      "type": "object"
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "work": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "theme": {
          "type": "string"
        },
        "createdBy": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "sourceNote": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string"
        },
        "total": {
          "type": "integer"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "unit"
      ],
      "additionalProperties": false
    },
    "faction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "description": {
          "type": "string"
        },
        "extra": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "quote": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "at": {
          "type": "integer"
        },
        "context": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "bio": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "appearance": {
          "type": "string"
        },
        "personality": {
          "type": "string"
        },
        "arc": {
          "type": "string"
        },
        "fate": {
          "type": "string"
        },
        "quotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quote"
          }
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    },
    "character": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "factionId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "importance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "status": {
          "enum": [
            "active",
            "deceased",
            "mentioned",
            "unknown"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "icon": {
          "type": "string"
        },
        "avatarUrl": {
          "type": "string"
        },
        "bio": {
          "$ref": "#/$defs/bio"
        },
        "firstAppearance": {
          "type": "integer"
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "pinned": {
          "type": "boolean"
        },
        "extra": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "importance",
        "bio"
      ],
      "additionalProperties": false
    },
    "chapters": {
      "type": "object",
      "properties": {
        "from": {
          "type": "integer"
        },
        "to": {
          "type": "integer"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "source": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "type": {
          "enum": [
            "family",
            "marriage",
            "romance",
            "friendship",
            "alliance",
            "rivalry",
            "mentorship",
            "service",
            "other"
          ]
        },
        "label": {
          "type": "string"
        },
        "directed": {
          "type": "boolean"
        },
        "strength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "polarity": {
          "enum": [
            "positive",
            "negative",
            "ambiguous",
            "neutral"
          ]
        },
        "description": {
          "type": "string"
        },
        "chapters": {
          "$ref": "#/$defs/chapters"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quote"
          }
        },
        "extra": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "type",
        "strength"
      ],
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "properties": {
        "focusNodeId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "fitIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "zoom": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "highlight": {
      "type": "object",
      "properties": {
        "characterIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "relationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "factionId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string"
        },
        "narration": {
          "type": "string"
        },
        "durationSec": {
          "type": "number"
        },
        "camera": {
          "$ref": "#/$defs/camera"
        },
        "highlight": {
          "$ref": "#/$defs/highlight"
        },
        "chapterAt": {
          "type": "integer"
        },
        "openBioId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "transitionMs": {
          "type": "number"
        },
        "extra": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "title",
        "durationSec"
      ],
      "additionalProperties": false
    }
  }
}
